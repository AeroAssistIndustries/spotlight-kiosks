# Landmark Digital theme assets — long-lived browser caching and automatic WebP delivery.
# Files are versioned (?ver=) so a year-long cache is safe; images get 30 days.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(jpe?g|png|webp|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  Header append Vary Accept env=REDIRECT_webp
</IfModule>
# Serve the .webp twin of a .jpg when the browser accepts WebP (same size, ~45% smaller).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_ACCEPT} image/webp
  RewriteCond %{REQUEST_FILENAME} \.jpe?g$
  RewriteCond %{REQUEST_FILENAME} ^(.+)\.jpe?g$
  RewriteCond %1.webp -f
  RewriteRule ^(.+)\.jpe?g$ $1.webp [T=image/webp,E=webp:1,L]
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/css application/javascript image/svg+xml application/json
</IfModule>
